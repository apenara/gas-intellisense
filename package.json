{
  "name": "gas-intellisense",
  "displayName": "Google Apps Script IntelliSense",
  "description": "Zero-config IntelliSense, autocompletion, and snippets for Google Apps Script",
  "version": "1.0.0",
  "publisher": "apenara",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "google apps script",
    "gas",
    "autocomplete",
    "intellisense",
    "google workspace",
    "sheets",
    "gmail",
    "drive"
  ],
  "activationEvents": [
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "javascript",
        "extensions": [".gs"],
        "aliases": ["Google Apps Script", "GAS"]
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/gas-snippets.json"
      }
    ],
    "configuration": {
      "title": "GAS IntelliSense",
      "properties": {
        "gasIntellisense.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable GAS code snippets"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@types/google-apps-script": "^2.0.7"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6",
    "ts-loader": "^9.4.4",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apenara/gas-intellisense"
  },
  "license": "MIT"
}
